# Plugin files change name (?ver=) or never change: browsers may keep them for a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|css|js|m4a|mp4)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
